<UserControl x:Class="Modena.RevitAddin.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Modena.RevitAddin.Views"
             SizeChanged="OnSizeChanged" FontFamily="Segoe UI" FontSize="12"
             Foreground="{DynamicResource TextPrimary}">
    <UserControl.Resources>
        <local:DeltaBrushConverter x:Key="DeltaBrush"/>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="#101827"/>
            <Setter Property="BorderBrush" Value="#23344c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90a4c8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,22,5"/>
        </Style>
        <Style x:Key="SummaryCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SummaryIcon" TargetType="Path">
            <Setter Property="Stroke" Value="#6d89ae"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="HistoryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="HistoryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BarBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BaselineButton" TargetType="Button" BasedOn="{StaticResource HistoryButton}">
            <Setter Property="Foreground" Value="{DynamicResource AccentAmber}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBaseline}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentAmber}"/>
                    <Setter Property="Foreground" Value="#0f1115"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CurrentButton" TargetType="Button" BasedOn="{StaticResource HistoryButton}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" Background="{TemplateBinding Background}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="#2d323c" BorderThickness="1" CornerRadius="4" Padding="8,7">
                                            <DockPanel>
                                                <TextBlock Text="⌄" DockPanel.Dock="Right" Foreground="#9ca3af" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#1a1d23" BorderBrush="#2d323c" BorderThickness="1" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#e5e7eb"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#263e66"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#111318"/>
                        <Setter Property="Foreground" Value="#9ca3af"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="6,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBaseline}" Value="True"><Setter Property="Background" Value="#332a18"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#1d2e4b"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChangeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Newly failing"><Setter Property="Foreground" Value="{DynamicResource AccentRed}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Regressed"><Setter Property="Foreground" Value="{DynamicResource AccentRed}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Resolved"><Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Improved"><Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryMessage" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource HistoryMessage}"/>
            <TextBlock Text="{Binding SaveWarning}" Style="{StaticResource HistoryMessage}" Foreground="{DynamicResource AccentAmber}"/>
            <UniformGrid x:Name="SummaryTiles" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource SummaryCard}" Margin="0,0,6,0"><Grid>
                    <Path Style="{StaticResource SummaryIcon}" Data="M 4,3 L 2,3 2,16 14,16 14,3 12,3 M 5,1 L 11,1 11,5 5,5 Z"/>
                    <StackPanel>
                        <TextBlock Text="SCANS LOGGED" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock Text="{Binding ScanCount}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Since}" Style="{StaticResource SummaryCaption}"/>
                    </StackPanel>
                </Grid></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,0,3,0"><Grid>
                    <Path>
                        <Path.Style><Style TargetType="Path" BasedOn="{StaticResource SummaryIcon}">
                            <Setter Property="Data" Value="M 1,8 L 15,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LatestDirection}" Value="1"><Setter Property="Data" Value="M 1,13 L 6,7 10,10 15,3 M 10,3 L 15,3 15,8"/></DataTrigger>
                                <DataTrigger Binding="{Binding LatestDirection}" Value="-1"><Setter Property="Data" Value="M 1,3 L 6,9 10,6 15,13 M 10,13 L 15,13 15,8"/></DataTrigger>
                            </Style.Triggers>
                        </Style></Path.Style>
                    </Path>
                    <StackPanel>
                        <TextBlock Text="LATEST PASS RATE" Style="{StaticResource SummaryLabel}"/>
                        <WrapPanel>
                            <TextBlock Text="{Binding LatestPassRate}" FontSize="24" FontWeight="Bold" Margin="0,0,8,0"/>
                            <Border x:Name="LatestDeltaBadge" CornerRadius="4" Padding="6,3" VerticalAlignment="Center"
                                    Background="{Binding LatestChange, Converter={StaticResource DeltaBrush}, ConverterParameter=Background}">
                                <Border.Style><Style TargetType="Border"><Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCompare}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></Border.Style>
                                <TextBlock Text="{Binding LatestDelta}" Foreground="{Binding LatestChange, Converter={StaticResource DeltaBrush}}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding LatestComparisonCaption}" Style="{StaticResource SummaryCaption}"/>
                    </StackPanel>
                </Grid></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="3,0,3,0"><Grid>
                    <Path Style="{StaticResource SummaryIcon}" Data="M 8,1 L 10,6 16,6 11,10 13,16 8,12 3,16 5,10 0,6 6,6 Z"/>
                    <StackPanel>
                        <TextBlock Text="BEST SCAN" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock Text="{Binding BestPassRate}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BestDate}" Style="{StaticResource SummaryCaption}"/>
                    </StackPanel>
                </Grid></Border>
                <Border Style="{StaticResource SummaryCard}" Margin="6,0,0,0"><Grid>
                    <Path>
                        <Path.Style><Style TargetType="Path" BasedOn="{StaticResource SummaryIcon}">
                            <Setter Property="Data" Value="M 1,8 L 15,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBelowBest}" Value="True"><Setter Property="Data" Value="M 1,3 L 6,9 10,6 15,13 M 10,13 L 15,13 15,8"/></DataTrigger>
                            </Style.Triggers>
                        </Style></Path.Style>
                    </Path>
                    <StackPanel>
                        <TextBlock Text="CHANGE SINCE BEST" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock Text="{Binding ChangeSinceBest}" Foreground="{Binding ChangeSinceBestValue, Converter={StaticResource DeltaBrush}}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{Binding BestComparisonCaption}" Style="{StaticResource SummaryCaption}"/>
                    </StackPanel>
                </Grid></Border>
            </UniformGrid>

            <Border Style="{DynamicResource DashboardCard}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <Button Content="Reload history" DockPanel.Dock="Right" Style="{StaticResource HistoryButton}" Command="{Binding ReloadCommand}" Margin="16,0,0,8" Padding="8,4"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="B  Baseline" Foreground="{DynamicResource AccentAmber}" Margin="0,0,16,0"/>
                            <TextBlock Text="C  Current" Foreground="{DynamicResource AccentBlue}"/>
                        </StackPanel>
                        <TextBlock Text="PASS RATE OVER TIME" Style="{StaticResource HistoryLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <local:TrendChart x:Name="HistoryChart" Records="{Binding Records}" Baseline="{Binding Baseline.Record}" Current="{Binding Current.Record}"
                                      Height="230" ToolTipService.InitialShowDelay="100" ToolTipService.ShowDuration="30000"/>
                </StackPanel>
            </Border>

            <Grid x:Name="DetailGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition x:Name="ComparisonColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="ScanPanel" Style="{DynamicResource DashboardCard}" Margin="0,0,8,0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="SCAN HISTORY" Style="{StaticResource HistoryLabel}"/>
                        <TextBlock Text="Choose B for baseline or C for current." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,12"/>
                        <DataGrid x:Name="ScanGrid" ItemsSource="{Binding PageScans, NotifyOnTargetUpdated=True}" TargetUpdated="OnScanPageChanged" Style="{StaticResource HistoryGrid}" Height="355">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="DATE / TIME" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding Date}"/>
                                    <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="RATE" Binding="{Binding Record.PassRate, StringFormat={}{0}%}" Width="50"/>
                                <DataGridTextColumn Header="PASSED" Binding="{Binding Passed}" Width="64"/>
                                <DataGridTextColumn Header="WARNINGS" Binding="{Binding Record.WarningsCount}" Width="68"/>
                                <DataGridTextColumn Header="ELEMENTS" Binding="{Binding Record.ModelElements, StringFormat=N0}" Width="70"/>
                                <DataGridTextColumn Header="VS PREVIOUS" Binding="{Binding PreviousDelta}" Width="90">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Delta, Converter={StaticResource DeltaBrush}}"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="COMPARE" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Content="B" Style="{StaticResource BaselineButton}" ToolTip="Use as baseline" Command="{Binding DataContext.SelectBaselineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                    <Button Content="C" Style="{StaticResource CurrentButton}" ToolTip="Use as current" Command="{Binding DataContext.SelectCurrentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button x:Name="PreviousScanPage" Content="Previous" Style="{StaticResource HistoryButton}" Command="{Binding PreviousPageCommand}" Padding="8,4"/>
                                <TextBlock x:Name="ScanPageSummary" Text="{Binding PageSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                                <Button x:Name="NextScanPage" Content="Next" Style="{StaticResource HistoryButton}" Command="{Binding NextPageCommand}" Padding="8,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PageRange}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ComparisonPanel" Grid.Column="1" Style="{DynamicResource DashboardCard}" Margin="8,0,0,0" VerticalAlignment="Stretch">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <WrapPanel DockPanel.Dock="Right" IsEnabled="{Binding CanCompare}" Margin="12,0,0,0">
                                <Button Content="Previous → latest" Style="{StaticResource HistoryButton}" Command="{Binding ComparePreviousCommand}" Margin="0,0,6,0"/>
                                <Button Content="Compare with best" Style="{StaticResource HistoryButton}" Command="{Binding CompareBestCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="COMPARE SCANS" Style="{StaticResource HistoryLabel}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid IsEnabled="{Binding CanCompare}" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Baseline (B)" Foreground="{DynamicResource AccentAmber}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="BaselineSelector" ItemsSource="{Binding Scans}" SelectedItem="{Binding Baseline}" DisplayMemberPath="Label" FontSize="11" ToolTip="{Binding Baseline.Label}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Current (C)" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding Scans}" SelectedItem="{Binding Current}" DisplayMemberPath="Label" FontSize="11" ToolTip="{Binding Current.Label}"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding BaselineCaption}" Foreground="{DynamicResource AccentAmber}" FontSize="11" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding CurrentCaption}" Foreground="{DynamicResource AccentBlue}" FontSize="11"/>
                        </WrapPanel>
                        <Border Background="{DynamicResource BarBg}" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <WrapPanel><TextBlock Text="{Binding ComparisonRate}" FontWeight="Bold" FontSize="20" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding ComparisonDelta}" Foreground="{Binding ComparisonChange, Converter={StaticResource DeltaBrush}}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/></WrapPanel>
                        </Border>
                        <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding CoverageSummary}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ListBox x:Name="ChangeFilter" ItemsSource="{Binding ChangeFilters}" SelectedItem="{Binding SelectedChangeFilter}"
                                 IsEnabled="{Binding CanCompare}" Background="Transparent" BorderThickness="0" Margin="0,0,0,10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Filter check changes">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template"><Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="FilterBorder" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,6,4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="FilterBorder" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FilterBorder" Property="BorderBrush" Value="White"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyChangesMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Changes.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <DataGrid ItemsSource="{Binding Changes}" MaxHeight="300" MinHeight="90">
                            <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource HistoryGrid}">
                                <Style.Triggers><DataTrigger Binding="{Binding Changes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style></DataGrid.Style>
                            <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/></Style></DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="CHECK" Width="*" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                    <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource PriorityBadge}" HorizontalAlignment="Left" Margin="0,3,0,2"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextSecondary}" FontSize="10"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="THEN → NOW" Binding="{Binding Counts}" Width="85"/>
                                <DataGridTemplateColumn Header="CHANGE" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource ChangeText}" FontSize="11"/>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding ComparisonNote}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="History is saved on this computer for your Windows user." Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,16,0,8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
