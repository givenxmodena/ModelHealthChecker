<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Legacy target: .NET Framework 4.8 for Revit 2024 -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Modena.RevitAddin</RootNamespace>
    <AssemblyName>Modena.RevitAddin</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <WarningsNotAsErrors>MSB3277</WarningsNotAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Debug configuration to launch Revit 2024 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\Autodesk\Revit 2024\Revit.exe</StartProgram>
    <StartArguments>/language ENU</StartArguments>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
    <StartWorkingDirectory>C:\Program Files\Autodesk\Revit 2024</StartWorkingDirectory>
  </PropertyGroup>

  <!-- Revit Legacy API References (resolve via env or default installed path) -->
  <PropertyGroup>
    <RevitLegacyApiDir Condition="'$(REVIT_LEGACY_API_DIR)' != ''">$(REVIT_LEGACY_API_DIR)</RevitLegacyApiDir>
    <RevitLegacyApiDir Condition="'$(RevitLegacyApiDir)' == '' and Exists('C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll')">C:\Program Files\Autodesk\Revit 2024</RevitLegacyApiDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitLegacyApiDir)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitLegacyApiDir)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Package References compatible with net48 -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Framework assembly references required for net48 -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Reference Modena.Shared (multi-targeted, will use netstandard2.0) -->
  <ItemGroup>
    <ProjectReference Include="..\Modena.Shared\Modena.Shared.csproj" />
  </ItemGroup>

  <!-- Include all source files from the Modern project -->
  <ItemGroup>
    <Compile Include="..\Modena.RevitAddin\**\*.cs"
             Exclude="..\Modena.RevitAddin\bin\**;..\Modena.RevitAddin\obj\**" />
    <Page Include="..\Modena.RevitAddin\**\*.xaml"
          Exclude="..\Modena.RevitAddin\bin\**;..\Modena.RevitAddin\obj\**" />
  </ItemGroup>

  <!-- Normalize logical paths for linked XAML pages so pack URIs resolve correctly -->
  <ItemGroup>
    <Page Update="..\Modena.RevitAddin\**\*.xaml">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Page>
  </ItemGroup>

  <!-- Copy .addin manifest and config to output directory -->
  <ItemGroup>
    <None Include="..\Modena.RevitAddin\Modena.RevitAddin.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Modena.RevitAddin.addin</Link>
    </None>
    <None Include="..\..\modena-config.json" Link="modena-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- PostBuild: deploy .addin to Revit 2024 addins folder (Debug only) -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="if not exist &quot;$(APPDATA)\Autodesk\Revit\Addins\2024&quot; mkdir &quot;$(APPDATA)\Autodesk\Revit\Addins\2024&quot;" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(TargetDir)Modena.RevitAddin.addin&quot; copy &quot;$(TargetDir)Modena.RevitAddin.addin&quot; &quot;$(APPDATA)\Autodesk\Revit\Addins\2024\Modena.RevitAddin.addin&quot;" IgnoreExitCode="true" />
    <Exec Command="powershell -NoProfile -Command &quot;$f = \&quot;$env:APPDATA\\Autodesk\\Revit\\Addins\\2024\\Modena.RevitAddin.addin\&quot;; if (Test-Path $f) { $c = Get-Content $f -Raw; $c = $c -replace '(?s)(&lt;Assembly&gt;).*?(&lt;/Assembly&gt;)', '&lt;Assembly&gt;$(TargetPath)&lt;/Assembly&gt;'; Set-Content -Path $f -Value $c -Encoding UTF8 }&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
