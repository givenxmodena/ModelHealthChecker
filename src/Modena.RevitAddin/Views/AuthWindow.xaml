<Window x:Class="Modena.RevitAddin.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in with Autodesk"
        Width="520" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Pulse"
                           Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" — Sign In"
                           Foreground="#888" FontSize="13"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- WebView2 (or fallback message) -->
        <Grid Grid.Row="1">
            <!-- Loading indicator shown until WebView2 is ready -->
            <Border x:Name="LoadingPanel" Background="#1E1E1E" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Loading sign-in page…"
                               Foreground="#888" FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- WebView2 — hidden initially, shown once NavigationCompleted fires -->
            <wv2:WebView2 x:Name="WebView"
                          Visibility="Collapsed"/>

            <!-- Fallback shown when WebView2 runtime is not installed -->
            <Border x:Name="FallbackPanel" Background="#1E1E1E" Visibility="Collapsed" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="WebView2 Runtime Not Found"
                               Foreground="#E07070" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="12"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Text="The Microsoft Edge WebView2 Runtime is required to sign in.&#x0a;&#x0a;Please download and install it from Microsoft, then restart Revit."/>
                    <Button x:Name="DownloadWebView2Button"
                            Content="Download WebView2 Runtime"
                            Margin="0,20,0,0" Padding="14,8"
                            HorizontalAlignment="Center"
                            Background="#0078D4" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2D2D30" Padding="16,10">
            <Grid>
                <TextBlock Text="Authentication is handled securely by Autodesk."
                           Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="CancelButton" Content="Cancel"
                        HorizontalAlignment="Right"
                        Padding="16,6" Background="#3C3C3C"
                        Foreground="#CCC" BorderThickness="0"
                        Cursor="Hand" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
