<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Legacy target: .NET Framework 4.8 for Revit 2024 -->
    <RootNamespace>Modena.RevitAddin</RootNamespace>
    <AssemblyName>Modena.RevitAddin</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <WarningsNotAsErrors>MSB3277</WarningsNotAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>
    <AssemblyInformationalVersion>1.0.6</AssemblyInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DefineConstants Condition="'$(DisableTrialVersion)' != 'true'">$(DefineConstants);TRIAL_VERSION</DefineConstants>
  </PropertyGroup>

  <!-- Package References compatible with net48 -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
  </ItemGroup>

  <!-- Revit does not probe runtimes subfolders — copy WebView2Loader.dll to output root -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <Exec Command="if exist &quot;$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll&quot; copy /Y &quot;$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll&quot; &quot;$(TargetDir)WebView2Loader.dll&quot;" IgnoreExitCode="true" />
  </Target>

  <!-- Framework assembly references required for net48 -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Reference Modena.Shared (multi-targeted, will use netstandard2.0) -->
  <ItemGroup>
    <ProjectReference Include="..\Modena.Shared\Modena.Shared.csproj" />
  </ItemGroup>

  <!-- Include all source files from the Modern project -->
  <ItemGroup>
    <Compile Include="..\Modena.RevitAddin\**\*.cs"
             Exclude="..\Modena.RevitAddin\bin\**;..\Modena.RevitAddin\obj\**" />
    <Page Include="..\Modena.RevitAddin\**\*.xaml"
          Exclude="..\Modena.RevitAddin\bin\**;..\Modena.RevitAddin\obj\**" />
  </ItemGroup>

  <!-- Normalize logical paths for linked XAML pages so pack URIs resolve correctly -->
  <ItemGroup>
    <Page Update="..\Modena.RevitAddin\**\*.xaml">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Page>
  </ItemGroup>

  <!-- Ribbon button icons — linked from the Modern project, copied next to the DLL -->
  <ItemGroup>
    <Content Include="..\Modena.RevitAddin\Resources\health-check_16.png" Link="Resources\health-check_16.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Modena.RevitAddin\Resources\health-check_32.png" Link="Resources\health-check_32.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Modena.RevitAddin\Resources\health-check_48.png" Link="Resources\health-check_48.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup><Content Include="..\Modena.RevitAddin\Registry\**\*.json" Link="Registry\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\Modena.RevitAddin\Resources\MHC_*.png" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <!-- Copy .addin manifest and config to output directory -->
  <ItemGroup>
    <None Include="..\Modena.RevitAddin\Modena.RevitAddin.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>Modena.RevitAddin.addin</Link>
    </None>
    <None Include="..\..\modena-config.json" Link="modena-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup><DefaultRevitYear>2024</DefaultRevitYear></PropertyGroup>
  <Import Project="..\..\build\Revit.props" />
  <Import Project="..\..\build\Mlbs.Desktop.Client.targets" />
  <Import Project="..\..\build\Revit.targets" />
</Project>
