<Window x:Class="Modena.RevitAddin.Views.ModelHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Modena.RevitAddin.ViewModels"
        xmlns:local="clr-namespace:Modena.RevitAddin.Views"
        Title="Modena Model Health Checker | v1.0.3"
        Width="1100" Height="750"
        MinWidth="800" MinHeight="500"
        Background="#0f1115"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Color palette -->
        <SolidColorBrush x:Key="CardBg" Color="#1a1d23"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2d323c"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#e5e7eb"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9ca3af"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6b7280"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3b82f6"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10b981"/>
        <SolidColorBrush x:Key="AccentRed" Color="#f43f5e"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#f59e0b"/>
        <SolidColorBrush x:Key="BarBg" Color="#1f2937"/>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Refresh button style -->
        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563eb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6b7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Priority badge template -->
        <DataTemplate x:Key="PriorityBadge">
            <Border CornerRadius="3" Padding="6,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1e293b"/>
                        <Setter Property="BorderBrush" Value="#475569"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Priority}" Value="HIGH">
                                <Setter Property="Background" Value="#1a0a0e"/>
                                <Setter Property="BorderBrush" Value="#7f1d1d"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Priority}" Value="MEDIUM">
                                <Setter Property="Background" Value="#1a150a"/>
                                <Setter Property="BorderBrush" Value="#78350f"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Priority}" Value="LOW">
                                <Setter Property="Background" Value="#0a1628"/>
                                <Setter Property="BorderBrush" Value="#1e3a5f"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Priority}" FontSize="9" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#94a3b8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Priority}" Value="HIGH">
                                    <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Priority}" Value="MEDIUM">
                                    <Setter Property="Foreground" Value="{StaticResource AccentAmber}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Priority}" Value="LOW">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">

                <!-- ===== HEADER ===== -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <!-- Subtle indicator shown only during silent background auto-refresh -->
                        <Border CornerRadius="3" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="#1a1d23" BorderBrush="#2d323c" BorderThickness="1"
                                Visibility="{Binding IsBackgroundRefreshing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⟳  Syncing" FontSize="10" Foreground="{StaticResource AccentBlue}"/>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="⟳  Re-Analyze Model" Style="{StaticResource RefreshButton}"
                                Command="{Binding LoadCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}, ConverterParameter=bool}"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" Height="24" Background="{StaticResource AccentBlue}"
                                    CornerRadius="2" Margin="0,0,8,0"/>
                            <TextBlock Text="Modena Model Health Checker" Foreground="White"
                                       FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12">
                                <Run Text="Model: "/>
                                <Run Text="{Binding ModelName, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium"/>
                            </TextBlock>
                            <TextBlock Text="  |  " Foreground="#374151" FontSize="12"/>
                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12">
                                <Run Text="Project: "/>
                                <Run Text="{Binding ProjectName, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium"/>
                            </TextBlock>
                            <TextBlock Text="  |  " Foreground="#374151" FontSize="12"/>
                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12">
                                <Run Text="Last Analyzed: "/>
                                <Run Text="{Binding LastRefreshedText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Medium"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <Border Height="1" Background="#1f2937" Margin="0,0,0,16"/>

                <!-- ===== CONFIG WARNING BANNER ===== -->
                <Border Visibility="{Binding HasConfigWarning, Converter={StaticResource BoolToVis}}"
                        Background="#1c1500" BorderBrush="#78350f" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="{StaticResource AccentAmber}" FontSize="12"
                                   FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfigWarningText}" Foreground="{StaticResource AccentAmber}"
                                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ===== LOADING STATE (only shown before first data; hides once fast phase completes) ===== -->
                <Border Visibility="{Binding IsInitialLoading, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" Margin="0,40,0,40">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⟳" FontSize="32" Foreground="{StaticResource AccentBlue}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Loading latest model health data..."
                                   Foreground="{StaticResource TextSecondary}" FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ===== ERROR STATE ===== -->
                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource InverseBoolToVis}}"
                        HorizontalAlignment="Center" Margin="0,20,0,20">
                    <Border Style="{StaticResource DashboardCard}" Padding="24" MaxWidth="500">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠" FontSize="28" Foreground="{StaticResource AccentAmber}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentRed}"
                                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- ===== EMPTY STATE ===== -->
                <Border HorizontalAlignment="Center" Margin="0,40,0,40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasData}" Value="False"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                        <Condition Binding="{Binding ErrorMessage}" Value="{x:Null}"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Click Re-Analyze Model to fetch model health data."
                                   Foreground="{StaticResource TextMuted}" FontSize="14"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ===== DATA STATE ===== -->
                <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">

                    <!-- KPI Cards Row -->
                    <UniformGrid Rows="1" Columns="5" Margin="0,0,0,16">
                        <!-- Pass Rate -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="48" Height="48" CornerRadius="24"
                                        BorderBrush="#10b98155" BorderThickness="4"
                                        Margin="0,0,12,0">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentGreen}">
                                        <Run Text="{Binding Summary.PassRate, Mode=OneWay, StringFormat={}{0}%}"/>
                                    </TextBlock>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="PASS RATE" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Good" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Total Checks -->
                        <Border Style="{StaticResource DashboardCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL CHECKS" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Summary.TotalChecks}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <!-- Failed Checks -->
                        <Border Style="{StaticResource DashboardCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="FAILED CHECKS" Foreground="{StaticResource AccentRed}"
                                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Summary.FailedChecks}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource AccentRed}"/>
                            </StackPanel>
                        </Border>
                        <!-- Warnings -->
                        <Border Style="{StaticResource DashboardCard}" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="WARNINGS" Foreground="{StaticResource AccentAmber}"
                                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Summary.Warnings}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource AccentAmber}"/>
                            </StackPanel>
                        </Border>
                        <!-- Model Elements -->
                        <Border Style="{StaticResource DashboardCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="MODEL ELEMENTS" Foreground="{StaticResource TextMuted}"
                                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Summary.ModelElements, StringFormat=N0}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Charts Row: Failed by Category | Check Distribution (Donut) | Severity -->
                    <Grid Margin="0,0,0,16" MinHeight="220" MaxHeight="300">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Failed Checks by Category (horizontal bars via ItemsControl) -->
                        <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Text="FAILED CHECKS BY CATEGORY" Style="{StaticResource SectionHeader}"/>
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Value}" DockPanel.Dock="Right"
                                                               Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                                </DockPanel>
                                                <Grid Height="6">
                                                    <Border Background="{StaticResource BarBg}" CornerRadius="3"/>
                                                    <Border Background="{StaticResource AccentBlue}" CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Width="{Binding Value, Converter={x:Static local:ValueToWidthConverter.Instance}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Check Distribution (Donut chart) -->
                        <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="CHECK DISTRIBUTION" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top"/>
                                <!-- Legend row (docked Bottom before fill child so DockPanel reserves space at bottom) -->
                                <UniformGrid Rows="1" Columns="3" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="PASSED" Foreground="{StaticResource AccentGreen}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Summary.PassedChecks}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="FAILED" Foreground="{StaticResource AccentRed}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Summary.FailedChecks}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="REPORTS" Foreground="{StaticResource AccentAmber}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Summary.ReportOnlyChecks}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>
                                <!-- Donut chart fills remaining center space -->
                                <Grid>
                                    <local:DonutChart Passed="{Binding Summary.PassedChecks}"
                                                      Failed="{Binding Summary.FailedChecks}"
                                                      Reports="{Binding Summary.ReportOnlyChecks}"/>
                                    <!-- Center label overlay -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding Summary.TotalChecks}" FontSize="28" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="TOTAL" Foreground="{StaticResource TextMuted}" FontSize="9"
                                                   HorizontalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Severity Breakdown (custom horizontal bar chart) -->
                        <Border Grid.Column="4" Style="{StaticResource DashboardCard}">
                            <DockPanel>
                                <TextBlock Text="SEVERITY BREAKDOWN" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top"/>
                                <local:HorizontalBarChart ItemsSource="{Binding Metrics}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Model Element Distribution (treemap-style) -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Summary.ModelElements, StringFormat='Total Elements: {0:N0}'}"
                                           DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                <TextBlock Text="MODEL ELEMENT DISTRIBUTION" Style="{StaticResource SectionHeader}" Margin="0"/>
                            </DockPanel>
                            <local:TreemapPanel Height="240" ItemsSource="{Binding Categories}"/>
                        </StackPanel>
                    </Border>

                    <!-- Top Families by Size -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <!-- Inline loading indicator shown while family sizes are being extracted -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsFamiliesLoading, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⟳" FontSize="11" Foreground="{StaticResource AccentBlue}"
                                               Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Loading..." Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="TOP FAMILIES BY USAGE" Style="{StaticResource SectionHeader}" Margin="0"/>
                            </DockPanel>
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Families}" Margin="0,0,10,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding InstanceCount, StringFormat='{}{0} placed'}" DockPanel.Dock="Right"
                                                           Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Failed Checks Detail Table -->
                    <Border Style="{StaticResource DashboardCard}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="16,16,16,0">
                                <TextBlock Text="FAILED CHECK DETAILS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding FailedChecks}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="#1a1d23" AlternatingRowBackground="#1e2128"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#2d323c"
                                      CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      Foreground="{StaticResource TextPrimary}"
                                      FontSize="12"
                                      Margin="0,8,0,0">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#111318"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="16,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#2d323c"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="16,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#252830"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1f2328"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CHECK NAME" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="COUNT" Binding="{Binding Count}" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="PRIORITY" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PriorityBadge}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DISCIPLINE" Binding="{Binding Discipline}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Passed Checks List -->
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="PASSED CHECKS" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding PassedChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="✓" Foreground="{StaticResource AccentGreen}"
                                                       FontSize="12" Margin="0,0,8,0" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
                <!-- End data state -->

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
