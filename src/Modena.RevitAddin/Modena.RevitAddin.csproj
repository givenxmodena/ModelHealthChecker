<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <WarningsNotAsErrors>MSB3277</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Debug configuration to launch Revit 2026 -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\Autodesk\Revit 2026\Revit.exe</StartProgram>
    <StartArguments>/language ENU</StartArguments>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
    <StartWorkingDirectory>C:\Program Files\Autodesk\Revit 2026</StartWorkingDirectory>
  </PropertyGroup>

  <!-- Revit 2026 API References -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2026\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modena.Shared\Modena.Shared.csproj" />
  </ItemGroup>

  <!-- Registry descriptors for Modena Suite -->
  <ItemGroup>
    <Content Include="Registry\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy .addin manifest and config to output directory -->
  <ItemGroup>
    <None Include="Modena.RevitAddin.addin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\modena-config.json" Link="modena-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- PostBuild: deploy .addin to Revit 2026 addins folder (Debug only) -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="if not exist &quot;$(APPDATA)\Autodesk\Revit\Addins\2026&quot; mkdir &quot;$(APPDATA)\Autodesk\Revit\Addins\2026&quot;" IgnoreExitCode="true" />
    <Exec Command="if exist &quot;$(TargetDir)Modena.RevitAddin.addin&quot; copy &quot;$(TargetDir)Modena.RevitAddin.addin&quot; &quot;$(APPDATA)\Autodesk\Revit\Addins\2026\Modena.RevitAddin.addin&quot;" IgnoreExitCode="true" />
    <Exec Command="powershell -NoProfile -Command &quot;$f = \&quot;$env:APPDATA\\Autodesk\\Revit\\Addins\\2026\\Modena.RevitAddin.addin\&quot;; if (Test-Path $f) { $c = Get-Content $f -Raw; $c = $c -replace '(?s)(&lt;Assembly&gt;).*?(&lt;/Assembly&gt;)', '&lt;Assembly&gt;$(TargetPath)&lt;/Assembly&gt;'; Set-Content -Path $f -Value $c -Encoding UTF8 }&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
